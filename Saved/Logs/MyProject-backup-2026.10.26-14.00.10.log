[2026.10.26-13.48.53:512][578]LogPython: import unreal

# 1. ตั้งค่า Path สำหรับจัดเก็บไฟล์ UI ในโปรเจกต์
package_path = "/Game/UI/iPad"
asset_tools = unreal.AssetToolsHelpers.get_asset_tools()

# สร้างโฟลเดอร์สำหรับเก็บ Widget Blueprint
unreal.EditorAssetLibrary.make_directory(package_path)

# 2. ฟังก์ชันช่วยปั๊มไฟล์ Widget Blueprint (UMG)
def create_widget_blueprint(name):
    factory = unreal.WidgetBlueprintFactory()
    factory.set_editor_property('parent_class', unreal.UserWidget)
    new_widget = asset_tools.create_asset(name, package_path, None, factory)
    if new_widget:
        unreal.log(f"Successfully created iPad Widget: {name}")
        unreal.EditorAssetLibrary.save_asset(f"{package_path}/{name}")
    else:
        unreal.log_error(f"Failed to create: {name}")

# 3. สั่งสร้างหน้าจอ LockScreen และ MainMenu สำหรับ iPad
create_widget_blueprint("WBP_iPad_LockScreen")
create_widget_blueprint("WBP_iPad_MainMenu")

