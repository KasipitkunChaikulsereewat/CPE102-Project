[2026.10.26-13.53.39:243][985]LogPython: import unreal

package_path = "/Game/UI/iPad"
editor_subsystem = unreal.get_editor_subsystem(unreal.UnrealEditorSubsystem)

# 1. ฟังก์ชันจัดโครงสร้างหน้าตาให้กับ Widget
def build_ipad_visuals():
    # โหลดไฟล์ที่เราเคยปั๊มไว้
    lockscreen_asset = unreal.load_asset(f"{package_path}/WBP_iPad_LockScreen")
    mainmenu_asset = unreal.load_asset(f"{package_path}/WBP_iPad_MainMenu")
    
    # --- จัดหน้า LockScreen ---
    if lockscreen_asset:
        # สร้าง Canvas Panel เป็นแกนหลักในการวางวัตถุ
        canvas = unreal.WidgetTreeBlueprintLibrary.create_widget(lockscreen_asset, unreal.CanvasPanel.static_class())
        unreal.WidgetTreeBlueprintLibrary.set_root_widget(lockscreen_asset, canvas)
        
        # ใส่รูปพื้นหลัง (Background Image) เต็มจอ
        bg_image = unreal.WidgetTreeBlueprintLibrary.create_widget(lockscreen_asset, unreal.Image.static_class())
        canvas_slot_bg = canvas.add_child(bg_image)
        # ตั้งค่า Anchor ให้เต็มจอ (Stretch)
        canvas_slot_bg.set_anchors(unreal.Anchors(minimum=[0.0, 0.0], maximum=[1.0, 1.0]))
        canvas_slot_bg.set_offsets(unreal.Margin(left=0.0, top=0.0, right=0.0, bottom=0.0))
        
        # สร้างกล่องข้อความนาฬิกา (Clock Text)
        clock_text = unreal.WidgetTreeBlueprintLibrary.create_widget(lockscreen_asset, unreal.TextBlock.static_class())
        clock_text.set_text(unreal.Text.as_culture_invariant("12:00"))
        canvas_slot_clock = canvas.add_child(clock_text)
        canvas_slot_clock.set_anchors(unreal.Anchors(minimum=[0.5, 0.2], maximum=[0.5, 0.2]))
        canvas_slot_clock.set_alignment(unreal.Vector2D(0.5, 0.5))
        
        # สร้างปุ่มปลดล็อก (Unlock Button) ด้านล่าง
        unlock_button = unreal.WidgetTreeBlueprintLibrary.create_widget(lockscreen_asset, unreal.Button.static_class())
        canvas_slot_btn = canvas.add_child(unlock_button)
        canvas_slot_btn.set_anchors(unreal.Anchors(minimum=[0.5, 0.8], maximum=[0.5, 0.8]))
        canvas_slot_btn.set_alignment(unreal.Vector2D(0.5, 0.5))
        canvas_slot_btn.set_size(unreal.Vector2D(300.0, 80.0))
        
        unreal.EditorAssetLibrary.save_asset(f"{package_path}/WBP_iPad_LockScreen")
        unreal.log("จัดหน้าตา WBP_iPad_LockScreen เรียบร้อยแล้ว!")

    # --- จัดหน้า MainMenu (Home Screen Grid) ---
    if mainmenu_asset:
        canvas_menu = unreal.WidgetTreeBlueprintLibrary.create_widget(mainmenu_asset, unreal.CanvasPanel.static_class())
        unreal.WidgetTreeBlueprintLibrary.set_root_widget(mainmenu_asset, canvas_menu)
        
        # สร้างระบบตาราง Grid สำหรับจัดไอคอนแอปสไตล์ iPad 
        grid_panel = unreal.WidgetTreeBlueprintLibrary.create_widget(mainmenu_asset, unreal.UniformGridPanel.static_class())
        canvas_slot_grid = canvas_menu.add_child(grid_panel)
        canvas_slot_grid.set_anchors(unreal.Anchors(minimum=[0.1, 0.1], maximum=[0.9, 0.8]))
        canvas_slot_grid.set_offsets(unreal.Margin(left=0.0, top=0.0, right=0.0, bottom=0.0))
        
        # ปั๊มปุ่มไอคอนแอปจำลองลงตาราง Grid (แถว และ คอลัมน์)
        apps = ["Google", "Camera", "Calculator", "Files"]
        for index, app_name in enumerate(apps):
            app_btn = unreal.WidgetTreeBlueprintLibrary.create_widget(mainmenu_asset, unreal.Button.static_class())
            grid_slot = grid_panel.add_child_to_uniform_grid(app_btn)
            # จัดแถวละ 2 แอป (0,0), (0,1), (1,0), (1,1)
            grid_slot.set_row(index // 2)
            grid_slot.set_column(index % 2)
            
        unreal.EditorAssetLibrary.save_asset(f"{package_path}/WBP_iPad_MainMenu")
        unreal.log("จัดโครงตารางไอคอนแอป WBP_iPad_MainMenu เรียบร้อยแล้ว!")

# สั่งรันลอจิกประกอบหน้าตา
build_ipad_visuals()

