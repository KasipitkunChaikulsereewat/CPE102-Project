[2026.10.26-13.50.25:995][497]LogPython: import unreal

package_path = "/Game/UI/iPad"
asset_tools = unreal.AssetToolsHelpers.get_asset_tools()

# ฟังก์ชันปั๊มไฟล์ Widget อัตโนมัติ
def create_widget(name):
    if unreal.EditorAssetLibrary.does_asset_exist(f"{package_path}/{name}"):
        return
    factory = unreal.WidgetBlueprintFactory()
    factory.set_editor_property('parent_class', unreal.UserWidget)
    new_widget = asset_tools.create_asset(name, package_path, None, factory)
    if new_widget:
        unreal.EditorAssetLibrary.save_asset(f"{package_path}/{name}")

# สั่งสร้างแอปที่เหลือให้ครบตามตาราง Phase 0 - 7
create_widget("WBP_iPad_Calculator") # แอปเครื่องคิดเลขวิทยาศาสตร์
create_widget("WBP_iPad_Browser")    # แอปเว็บเบราว์เซอร์ Google
create_widget("WBP_iPad_Camera")     # แอปกล้องถ่ายรูป
create_widget("WBP_iPad_Files")      # แอปคลังภาพ/ไฟล์ภาพถ่าย
create_widget("WBP_PhotoThumbnail")   # ชิ้นส่วนแสดงรูปขนาดเล็กในแอปไฟล์

unreal.log("All iPad Apps generated completely!")

