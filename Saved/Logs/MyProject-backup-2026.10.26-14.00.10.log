[2026.10.26-13.55.02:511][133]LogPython: import unreal

package_path = "/Game/UI/iPad"
subsystem = unreal.get_editor_subsystem(unreal.UnrealEditorSubsystem)

def build_ipad_ui_fixed():
    # 1. โหลดไฟล์ Asset
    lock_widget = unreal.load_asset(f"{package_path}/WBP_iPad_LockScreen")
    menu_widget = unreal.load_asset(f"{package_path}/WBP_iPad_MainMenu")
    
    # 📱 --- ประกอบหน้าจอล็อก (WBP_iPad_LockScreen) ---
    if lock_widget:
        # ใช้ Subsystem รีเซ็ต Widget Tree ใหม่
        unreal.WidgetEditingLibrary.clear_widget_blueprint_compiler_errors(lock_widget)
        widget_tree = lock_widget.get_editor_property("widget_tree")
        
        # คลีนของเก่าออกก่อน
        for w in widget_tree.get_all_widgets():
            widget_tree.remove_widget(w)
            
        # สร้าง Canvas Panel หลัก
        root_canvas = widget_tree.construct_widget(unreal.CanvasPanel.static_class(), "RootCanvas")
        widget_tree.set_root_widget(root_canvas)
        
        # เพิ่มรูปพื้นหลังสไตล์ iPad
        bg_image = widget_tree.construct_widget(unreal.Image.static_class(), "Wallpaper")
        bg_slot = root_canvas.add_child(bg_image)
        bg_slot.set_anchors(unreal.Anchors(minimum=[0.0, 0.0], maximum=[1.0, 1.0]))
        bg_slot.set_offsets(unreal.Margin(left=0.0, top=0.0, right=0.0, bottom=0.0))
        
        # เพิ่มข้อความนาฬิกาดิจิทัลตัวใหญ่
        clock_text = widget_tree.construct_widget(unreal.TextBlock.static_class(), "Text_Clock")
        clock_text.set_text(unreal.Text.as_culture_invariant("12:00"))
        clock_slot = root_canvas.add_child(clock_text)
        clock_slot.set_anchors(unreal.Anchors(minimum=[0.5, 0.25], maximum=[0.5, 0.25]))
        clock_slot.set_alignment(unreal.Vector2D(0.5, 0.5))
        
        # เพิ่มปุ่มกดปลดล็อกหน้าจอ
        unlock_btn = widget_tree.construct_widget(unreal.Button.static_class(), "Btn_Unlock")
        btn_slot = root_canvas.add_child(unlock_btn)
        btn_slot.set_anchors(unreal.Anchors(minimum=[0.5, 0.75], maximum=[0.5, 0.75]))
        btn_slot.set_alignment(unreal.Vector2D(0.5, 0.5))
        btn_slot.set_size(unreal.Vector2D(350.0, 90.0))
        
        # ⚠️ สำคัญมาก: สั่งบันทึกและรีเฟรช Editor ของตัว Widget
        unreal.WidgetEditingLibrary.compile_widget_blueprint(lock_widget)
        unreal.EditorAssetLibrary.save_asset(f"{package_path}/WBP_iPad_LockScreen")
        unreal.log("ประกอบและบันทึกหน้า WBP_iPad_LockScreen สำเร็จ!")

    # 🖥️ --- ประกอบหน้าจอโฮมและไอคอนแอป (WBP_iPad_MainMenu) ---
    if menu_widget:
        widget_tree = menu_widget.get_editor_property("widget_tree")
        for w in widget_tree.get_all_widgets():
            widget_tree.remove_widget(w)
            
        root_canvas = widget_tree.construct_widget(unreal.CanvasPanel.static_class(), "RootCanvas")
        widget_tree.set_root_widget(root_canvas)
        
        # สร้างตารางสี่เหลี่ยม Uniform Grid สำหรับแบ่งไอคอนแอป
        grid = widget_tree.construct_widget(unreal.UniformGridPanel.static_class(), "AppGrid")
        grid_slot = root_canvas.add_child(grid)
        grid_slot.set_anchors(unreal.Anchors(minimum=[0.1, 0.1], maximum=[0.9, 0.8]))
        grid_slot.set_offsets(unreal.Margin(left=0.0, top=0.0, right=0.0, bottom=0.0))
        
        # ปั๊มปุ่มจำลองไอคอนแอปพลิเคชัน 4 แอปหลัก
        apps = ["Safari_Google", "Camera", "Calculator", "Files"]
        for i, app_name in enumerate(apps):
            btn = widget_tree.construct_widget(unreal.Button.static_class(), f"Btn_{app_name}")
            slot = grid.add_child_to_uniform_grid(btn)
            slot.set_row(i // 2)
            slot.set_column(i % 2)
            
        unreal.WidgetEditingLibrary.compile_widget_blueprint(menu_widget)
        unreal.EditorAssetLibrary.save_asset(f"{package_path}/WBP_iPad_MainMenu")
        unreal.log("ประกอบและบันทึกหน้า WBP_iPad_MainMenu สำเร็จ!")

# สั่งทำงานทันที
build_ipad_ui_fixed()

